import React, { useState } from "react";
import "./index.css";
import sampleImage from "D:/23cs158/lab7/src/assets/hero.png"
const ProfileCard = ({ name, bio, initialBg }) => {
  const [bg, setBg] = useState(initialBg);

  return (
    <div
      className="card"
      style={{ background: bg }}
      onMouseEnter={() => setBg("linear-gradient(135deg, #FFD700, #FFA07A)")}
      onMouseLeave={() => setBg(initialBg)}
    >
      <img src={sampleImage} alt={name} className="pic" />
      <h2>{name}</h2>
      <p>{bio}</p>
    </div>
  );
};

export default function App() {
  return (
    <div className="container">
      <ProfileCard
        name="Steve Jobs"
        bio="Co-founder of Apple Inc."
        initialBg="linear-gradient(135deg, #ADD8E6, #E6E6FA)"
      />
    </div>
  );
}


index.css

/* Reset default styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Poppins', sans-serif;
}

/* Container styling */
.container {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #f4f6f9;
}

/* Profile Card */
.card {
  width: 300px;
  padding: 20px;
  border-radius: 20px;
  text-align: center;
  color: #333;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  cursor: pointer;
}

/* Hover effect */
.card:hover {
  transform: translateY(-10px) scale(1.03);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
}

/* Profile Image */
.pic {
  width: 120px;
  height: 120px;
  border-radius: 50%; /* Makes it circular */
  object-fit: cover;
  border: 4px solid white;
  margin-bottom: 15px;
  transition: transform 0.3s ease;
}

/* Image hover animation */
.card:hover .pic {
  transform: scale(1.1);
}

/* Name styling */
.card h2 {
  font-size: 1.5rem;
  margin-bottom: 10px;
  color: #222;
}

/* Bio styling */
.card p {
  font-size: 0.95rem;
  color: #555;
  line-height: 1.5;
}

/* Responsive Design */
@media (max-width: 480px) {
  .card {
    width: 90%;
    padding: 15px;
  }

  .pic {
    width: 100px;
    height: 100px;
  }

  .card h2 {
    font-size: 1.3rem;
  }

  .card p {
    font-size: 0.9rem;
  }
}
