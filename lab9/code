/* Reset default browser styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Body styling */
body {
  font-family: Arial, Helvetica, sans-serif;
  background-color: #f5f5f5;
  text-align: center;
}

/* Navigation bar */
nav {
  background-color: #ffffff;
  padding: 15px 0;
  border-bottom: 2px solid #ddd;
}

/* Links */
nav a {
  margin: 0 15px;
  font-size: 18px;
  color: black;
  text-decoration: none;
  transition: 0.3s;
}

/* Hover effect */
nav a:hover {
  color: blue;
}

/* Active link (react-router applies this class) */
nav a.active {
  color: blue;
  font-weight: bold;
}

/* Page content */
h2 {
  margin-top: 40px;
  font-size: 28px;
  color: #333;
}



